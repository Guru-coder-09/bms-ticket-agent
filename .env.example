# ========================================================
# BOOKMYSHOW MONITOR AGENT ENVIRONMENT CONFIGURATION
# ========================================================

# 1. TELEGRAM BOT (Recommended - Instant Push Notification on Mobile)
# Create a bot via @BotFather on Telegram to get your token.
# Message @userinfobot to get your numeric Chat ID.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# 2. DISCORD WEBHOOK (Optional alternative)
# Create a Webhook under Server Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=
